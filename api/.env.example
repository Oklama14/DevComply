# Copie para .env e defina os valores. Marcadores entre < > sao propositais: um
# arquivo de exemplo com valor que parece senha de verdade acaba copiado tal qual
# para producao com frequencia desconfortavel.

DB_HOST=localhost
DB_PORT=5432
DB_USER=devcomply_user
DB_PASS=<defina-uma-senha-forte>
DB_NAME=devcomply_db

# openssl rand -base64 48
JWT_SECRET=<gere-um-valor-aleatorio-forte>

# openssl rand -base64 32 — cifra a chave do Gemini do usuario em repouso
APP_ENCRYPTION_KEY=<gere-um-valor-aleatorio-forte>

# Opcional: sem ela, os relatorios so funcionam com a chave do proprio usuario
GOOGLE_API_KEY=<opcional-chave-do-gemini>

NODE_ENV=development
